# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Razorpay Configuration (Test / Live Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId12345
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# App URL (for dynamic QR, SSR links, OpenGraph metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email & SMTP Configuration (For real inbox OTP delivery)
# Option A: Resend (https://resend.com)
RESEND_API_KEY=

# Option B: Standard SMTP (Gmail App Password, Brevo, SendGrid, Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MyDigiCatalogue" <noreply@mydigicatalogue.com>

